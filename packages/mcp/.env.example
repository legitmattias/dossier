# Dossier MCP Server Configuration
# Copy to .env and adjust values

# Transport mode: "stdio" (default, for Claude Code) or "http" (network service)
DOSSIER_TRANSPORT=stdio

# HTTP transport settings (only used when DOSSIER_TRANSPORT=http)
DOSSIER_PORT=3100
DOSSIER_HOST=0.0.0.0

# API key for HTTP transport authentication (required for HTTP mode)
# Generate with: node -e "console.log(crypto.randomUUID())"
DOSSIER_API_KEY=

# Path to profile JSON file (default: ~/.config/dossier/profile.json)
# DOSSIER_PROFILE=/path/to/profile.json
