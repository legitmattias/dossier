# Dossier API Configuration
# Copy to .env and adjust values

# Database connection
# PostgreSQL: postgres://user:password@localhost:5432/dossier
# SQLite:     sqlite:./data/dossier.db
DATABASE_URL=postgres://dossier:dossier@localhost:5432/dossier

# Server
PORT=3200
HOST=0.0.0.0

# Auth
# Generate with: node -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
JWT_SECRET=

# Optional: allowed CORS origins (comma-separated). Default: * in dev
# CORS_ORIGINS=https://dossier.mattic.dev,https://mattic.dev
