# Dossier API Configuration
# Copy to .env and adjust values

# Database connection (PostgreSQL)
# Default port 5433 matches docker/docker-compose.dev.yml
DATABASE_URL=postgres://dossier:dossier@localhost:5433/dossier_test

# Server
PORT=3200
HOST=0.0.0.0

# Auth
# Generate with: node -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
JWT_SECRET=

# Optional: allowed CORS origins (comma-separated). Default: * in dev
# CORS_ORIGINS=https://dossier.example.com,https://example.com
