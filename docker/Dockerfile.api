# Stage 1: Install dependencies and build
FROM node:22-slim AS builder

RUN corepack enable pnpm

WORKDIR /app

# Copy workspace config and lockfile first (layer cache)
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./

# Copy package.json files for needed packages
COPY packages/core/package.json packages/core/
COPY packages/api/package.json packages/api/

# Install all dependencies
RUN CI=true pnpm install --frozen-lockfile

# Copy source code
COPY packages/core/ packages/core/
COPY packages/api/ packages/api/

# Build both packages
RUN pnpm -r --filter @dossier/core --filter @dossier/api run build

# Remove dev dependencies, re-install prod only (preserves workspace links)
RUN rm -rf node_modules packages/*/node_modules && \
    CI=true pnpm install --frozen-lockfile --prod

# Stage 2: Production image
FROM node:22-slim AS runtime

RUN groupadd --system dossier && useradd --system --gid dossier dossier

WORKDIR /app

# Copy the entire pruned workspace (preserves pnpm symlinks)
COPY --from=builder /app/ ./

# Remove source files
RUN rm -rf packages/core/src packages/api/src tsconfig.base.json

# Create data directory for SQLite mode
RUN mkdir -p /data && chown dossier:dossier /data

ENV PORT=3200
ENV HOST=0.0.0.0
ENV NODE_ENV=production

EXPOSE 3200

USER dossier

CMD ["node", "packages/api/dist/bin.mjs"]
