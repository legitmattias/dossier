# Dossier Production — /srv/dossier/.env
# Copy this to /srv/dossier/.env on the VPS

# --- Container images ---
# Your GHCR namespace (matches where the deploy workflow pushes images).
DOSSIER_IMAGE_PREFIX=ghcr.io/your-org

# --- PostgreSQL ---
POSTGRES_USER=dossier
POSTGRES_PASSWORD=   # Generate: openssl rand -hex 24
POSTGRES_DB=dossier

# --- API ---
JWT_SECRET=          # Generate: openssl rand -hex 32
API_PORT=3200
CORS_ORIGINS=https://dossier.example.com

# --- MCP Server ---
MCP_API_KEY=         # Generate: openssl rand -hex 24
MCP_PORT=3150
