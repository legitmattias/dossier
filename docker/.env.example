# Dossier Docker Configuration
# Copy to .env and set required values

# --- Required ---

# MCP server API key
# Generate with: node -e "console.log(crypto.randomUUID())"
DOSSIER_API_KEY=

# PostgreSQL password
POSTGRES_PASSWORD=

# JWT secret for API authentication
# Generate with: node -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
JWT_SECRET=

# --- Optional ---

# PostgreSQL
# POSTGRES_USER=dossier
# POSTGRES_DB=dossier

# Published ports
# MCP_PORT=3100
# API_PORT=3200

# CORS (comma-separated origins, or leave empty for *)
# CORS_ORIGINS=https://dossier.mattic.dev
